# ==============================================================================
# Resmeet-STT .gitignore
# ==============================================================================
# Prinsip:
#   - Semua kode sumber, Dockerfile, script startup, dan .env.example di-upload ke Git.
#   - Semua rahasia (.env, *.key), database lokal, bobot model AI (>500MB),
#     rekaman audio/video pengguna, cache, dan artefak build tidak di-upload.
#   - Folder kosong yang dibutuhkan runtime dipertahankan melalui file .gitkeep.

# 1. Environment variables & encryption secrets (wajib disiapkan lokal dari .env.example)
.env
*.env
.env.*
!.env.example
backend/.env
frontend/.env
backend/.db_secret.key
backend/ai-encryption.key

# 2. macOS & OS artifacts
.DS_Store
**/.DS_Store
._*
**/._*
Thumbs.db

# 3. Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/whisperx-env/
venv/
.venv/
**/.venv/
env/

# 4. Model binaries & lock files (unduh manual atau via backend/scripts/download_models.py)
backend/models/*
!backend/models/.gitkeep
backend/.locks/
backend/models--*
*.bin
*.onnx
*.pt
*.safetensors

# 5. Media recordings & uploads (jangan pernah upload rekaman rapat privat ke Git)
backend/uploads/*
!backend/uploads/.gitkeep
*.m4a
*.mp3
*.wav
*.ogg
*.flac
*.aac
*.mp4
*.mkv
*.webm
*.mpeg
*.mpg
*.mpe
*.mpga

# 6. Node, Rust & Package Manager builds
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
backend/dist/
frontend/dist-ssr/
frontend/*.local
target/
backend/target/

# 7. Local databases, state & legacy artifacts
backend/settings.json
backend/transcription_cache.json
backend/transcription_cache.json.tmp
backend/database.json
backend/database.json.tmp
backend/transcripts_md/*
!backend/transcripts_md/.gitkeep
*.db
*.sqlite
*.sqlite-wal
*.sqlite-shm
release/
desktop/dist/
desktop/node_modules/
desktop/bin/
backend/bin/
backend/src_ts/

# 8. Logs
*.log
logs/
frontend/logs/

# 9. IDE, Editor & Agent local files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
task.md
skills/

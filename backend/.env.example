# ==============================================================================
# Resmeet-STT Backend Environment Example (Local / Non-Docker Mode)
# ==============================================================================
# Salin file ini menjadi backend/.env sebelum menjalankan ./start-non-docker.sh:
#   cp backend/.env.example backend/.env

# --- 1. Database PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=stt_db
DB_USER=postgres
DB_PASSWORD=change_me_postgres_password
DATABASE_URL=postgres://postgres:change_me_postgres_password@127.0.0.1:5433/stt_db

# --- 2. Server & Logging ---
PORT=8200
APP_ROLE=api
RUST_LOG=resmeet_backend=info,tower_http=info

# --- 3. Speech-to-Text Runtime (Whisper large-v3-turbo) ---
WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
# Kosongkan MODEL_DIR agar otomatis memakai ./backend/models
MODEL_DIR=
STT_ENGINE=auto
CPU_THREADS=6
STT_BATCH_SIZE=1
STT_CHUNK_SECONDS=45
STT_CONCURRENCY=2
VAD_ENABLED=true
WHISPER_VAD_MODEL=ggml-silero-v6.2.0.bin
MODEL_IDLE_SECONDS=300

# Opsional: tentukan path manual jika binary/venv tidak berada di PATH standar
# WHISPER_SERVER=/usr/local/bin/whisper-server
# FASTER_WHISPER_MODEL_DIR=./models/faster-whisper-large-v3-turbo
# FASTER_WHISPER_PYTHON=./.venv/bin/python

# ─── MySQL ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3307
DB_NAME=stt_db
DB_USER=root
DB_PASSWORD=password

# ─── Whisper Model ────────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3-turbo
MODEL_DIR=

# ─── Device ───────────────────────────────────────────────────────────────────
DEVICE=cpu
COMPUTE_TYPE=int8
CPU_THREADS=2
BATCH_SIZE=1
ENABLE_AUDIO_DENOISE=false

# ─── AI Correction / RAG (Jev-ultrafast Guided Topics) ─────────────────────────
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=your_api_key_here
AI_MODEL_ID=9R-Gemini
AI_TIMEOUT_S=120
AI_ENABLE_CORRECTION=true
AI_ENABLE_KNOWLEDGE_EXTRACTION=true
AI_ENABLE_RAG=true

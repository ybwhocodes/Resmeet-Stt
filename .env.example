# ==============================================================================
# Resmeet-STT Root Environment Example (Docker Compose Mode)
# ==============================================================================
# Salin file ini menjadi .env sebelum menjalankan ./start-docker.sh:
#   cp .env.example .env

# --- 1. Database PostgreSQL ---
# Jika PostgreSQL berjalan di host mesin (atau container terpisah di port 5433),
# gunakan host.docker.internal. Jika memakai service dalam network yang sama, isi nama service.
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=stt_db
DB_USER=postgres
DB_PASSWORD=change_me_postgres_password
DATABASE_URL=postgres://postgres:change_me_postgres_password@host.docker.internal:5433/stt_db
DB_SETUP_HOST=host.docker.internal

# --- 2. Server & API ---
PORT=8200
RUST_LOG=resmeet_backend=info,tower_http=info

# --- 3. Model & Mesin STT (Whisper large-v3-turbo) ---
# Pastikan file model tersedia di ./backend/models/
WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
MODEL_DIR=/app/models
STT_ENGINE=auto
VAD_ENABLED=true
WHISPER_VAD_MODEL=ggml-silero-v6.2.0.bin

# --- 4. Optimasi Kecepatan & Resource Container ---
CPU_THREADS=6
STT_BATCH_SIZE=1
STT_CHUNK_SECONDS=45
STT_CONCURRENCY=2
MODEL_IDLE_SECONDS=300
RESMEET_CPU_LIMIT=4.0
RESMEET_API_CPU_LIMIT=0.5
RESMEET_AI_CPU_LIMIT=0.5
RESMEET_GPU=auto

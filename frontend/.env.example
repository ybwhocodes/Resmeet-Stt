# ==============================================================================
# Resmeet-STT Frontend Environment Example (Vite / React 19)
# ==============================================================================
# Salin menjadi frontend/.env jika ingin mengarahkan API ke host khusus:
#   cp frontend/.env.example frontend/.env
# Secara default "/api" akan diteruskan oleh proxy Vite (lokal) atau Nginx (Docker).
VITE_API_BASE_URL=/api

{
  "name": "resmeet-stt-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Resmeet-STT: Enterprise Meeting Notetaker & Speech-to-Text (Pure Web + Rust Axum + React.js + PostgreSQL + Docker)",
  "scripts": {
    "dev": "bash start.sh",
    "docker:up": "bash start.sh -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "backend:check": "cd backend && cargo check",
    "backend:dev": "cd backend && cargo run",
    "backend:build": "cd backend && cargo build --release",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  }
}
